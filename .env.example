# trade_bot.py icin ayarlar. Bu dosyayi ".env" olarak kopyalayip kendi
# degerlerinizi girin. ".env" asla git'e eklenmemeli (.gitignore'da zaten var).

# dry_run = emir gonderilmez, sadece simule/telegram bildirimi (varsayilan, guvenli)
# testnet = Binance Spot Testnet'te sahte parayla gercek emir
# live    = GERCEK PARAYLA gercek emir (ayrica CONFIRM_REAL_MONEY=EVET gerekir)
MODE=dry_run

SYMBOL=SHIBUSDT
BASE_ASSET=SHIB
QUOTE_ASSET=USDT
TRADE_PERCENT=33
POLL_INTERVAL_SECONDS=300
RSI_BUY_THRESHOLD=30
RSI_SELL_THRESHOLD=70

# testnet icin: https://testnet.binance.vision uzerinden alinir
# live icin: Binance hesabinizdan, sadece "Spot Trading" izniyle, "Withdraw" izni OLMADAN olusturun
BINANCE_API_KEY=
BINANCE_API_SECRET=

# MODE=live icin zorunlu ek onay
CONFIRM_REAL_MONEY=

# Telegram ile telefon bildirimi (BotFather'dan token, @userinfobot'tan chat id alinir)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
