# trade_bot.py icin ayarlar. Bu dosyayi ".env" olarak kopyalayip kendi
# degerlerinizi girin. ".env" asla git'e eklenmemeli (.gitignore'da zaten var).

# dry_run = emir gonderilmez, sadece simule/telegram bildirimi (varsayilan, guvenli)
# testnet = Binance Spot Testnet'te sahte parayla gercek emir
# live    = GERCEK PARAYLA gercek emir (ayrica CONFIRM_REAL_MONEY=EVET gerekir)
MODE=dry_run

SYMBOL=SHIBUSDT
BASE_ASSET=SHIB
QUOTE_ASSET=USDT
TRADE_PERCENT=33
STOP_LOSS_PERCENT=3
TAKE_PROFIT_PERCENT=6
MAX_DAILY_LOSS_PERCENT=2
EMERGENCY_STOP_FILE=STOP_BOT

# Ne kadar sik kontrol etsin (saniye) ve hangi mum araligina baksin.
# Yalnizca kapanmis mumlar sinyal uretir; ayni mumda tekrar emir verilmez.
POLL_INTERVAL_SECONDS=60
KLINE_INTERVAL=15m

RSI_BUY_THRESHOLD=30
RSI_SELL_THRESHOLD=70

# Trend filtresi: kisa EMA > uzun EMA ise "yukselis trendi" kabul edilir.
# ALIM sadece yukselis trendinde yapilir; trend asagi donerse (RSI 70'e gelmese bile)
# pozisyon korumak icin SATIS tetiklenir.
EMA_TREND_SHORT=50
EMA_TREND_LONG=200
EMA_SLOPE_LOOKBACK=5
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=2.0
ATR_TAKE_PROFIT_MULTIPLIER=3.0
VOLUME_PERIOD=20
VOLUME_MULTIPLIER=1.20

# testnet icin: https://testnet.binance.vision uzerinden alinir
# live icin: Binance hesabinizdan, sadece "Spot Trading" izniyle, "Withdraw" izni OLMADAN olusturun
BINANCE_API_KEY=
BINANCE_API_SECRET=

# MODE=live icin zorunlu ek onay
CONFIRM_REAL_MONEY=

# Telegram ile telefon bildirimi (BotFather'dan token, @userinfobot'tan chat id alinir)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# backtest.py icin ek ayarlar
BACKTEST_DAYS=30
BACKTEST_START_CAPITAL=1000
TRADING_FEE_PERCENT=0.1
# true: backtest USDT yerine SHIB ile baslar, "token adedi degisimi" raporlar
# (dolar degerini degil, uzun vadede tuttugunuz token miktarini artirmak
# isteyenler icin - bkz. grid_bot.py / grid_backtest.py)
START_IN_SHIB=false

# --- grid_bot.py / grid_backtest.py (ONERILEN/VARSAYILAN STRATEJI - gercek
# SHIBUSDT verisiyle 30/90/180 gunde test edilen 3 secenek arasinda en
# TUTARLI sonucu veren bu oldu): RSI/trend'e bakmayan salinim (grid)
# stratejisi. Referans fiyattan %X dusunce AL, o lotun giris fiyatindan %Y
# yukselince o lotu SAT. Amac dolar degil, TOKEN ADEDI biriktirmek - sadece
# gercekten yatay/dalgali (net trendsiz) piyasada islevseldir; guclu tek
# yonlu trendde (yukari da olsa asagi da olsa) basit tutmaktan geride kalir.
GRID_STEP_DOWN_PERCENT=1
GRID_STEP_UP_PERCENT=1
GRID_ORDER_PERCENT=10
GRID_MAX_OPEN_LOTS=8
GRID_RESERVE_PERCENT=20
GRID_POLL_INTERVAL_SECONDS=30
GRID_KLINE_INTERVAL=5m
# Bir grid lotu hic hedefine ulasmadan bu kadar zarara duserse, sonsuza kadar
# acik kalmasin diye zararina kapatilir (sermaye kilitlenme riskine karsi).
GRID_LOT_STOP_PERCENT=10

# Elde zaten SHIB var ama USDT yoksa (bot "USDT bakiyesi yetersiz" der ve hic
# alim yapamaz) bu ayari kullanin: ilk calismada mevcut BASE_ASSET bakiyesinin
# bu yuzdesi tek seferlik "baslangic lotu" olarak grid havuzuna kaydedilir -
# fiyat GRID_STEP_UP_PERCENT kadar yukselince satilir, sonra GRID_STEP_DOWN_PERCENT
# dusunce geri alinir. Geri kalan yuzdeye bot HIC dokunmaz, sadece bu pay aktif
# ticarete girer. 0 = kapali (varsayilan, eski davranis).
GRID_SEED_SHIB_PERCENT=0

# Grid adimina (%1) DOKUNMADAN, sadece YENI ALIM sinyaline saatlik/gunluk
# trend filtresi eklemek icin: son 1 saatlik veya son 24 saatlik degisim bu
# esiklerin ALTINDAYSA (guclu dususteyse), o dongude yeni alim atlanir -
# "dusen bicagi yakalama" riskini azaltir. SATIS (kar hedefi/stop-loss) bu
# filtreden HIC etkilenmez. -100 = kapali (varsayilan, hicbir zaman engellemez).
# Ornek: -3 ve -5 verirseniz, son 1 saatte %3'ten fazla VEYA son 24 saatte
# %5'ten fazla dusus varsa yeni alim o an icin atlanir.
GRID_TREND_FILTER_1H_PERCENT=-100
GRID_TREND_FILTER_24H_PERCENT=-100
# Trend filtresi acikken kac saniyede bir Binance'ten saatlik/gunluk veri
# cekilsin (canli botta gereksiz API yukunu onlemek icin cache suresi).
GRID_TREND_CHECK_INTERVAL_SECONDS=300

# "Gunluk/saatlik trendi takip edip o payla islem yap" ozelligi: seed edilen
# SHIB havuzunun (GRID_SEED_SHIB_PERCENT) bu yuzdesi, grid'den TAMAMEN AYRI
# kendi ic sayaçlarini tutan bagimsiz bir trend takip alt-havuzuna ayrilir.
# Hem son 1 saatlik hem son 24 saatlik degisim GRID_TREND_ENTRY_PERCENT'in
# USTUNDEYSE SHIB'de kalir/alir; ikisinden biri GRID_TREND_EXIT_PERCENT'in
# ALTINA duserse USDT'ye satar. Bu alt-havuz grid'in parasina hic dokunmaz
# (ayni surec icinde, kendi ic muhasebesiyle calisir - iki ayri bot
# calistirmanin getirecegi bakiye çakışması riski yok). 0 = kapali
# (varsayilan). ONEMLI: Gercek veriyle backtest ettigimizde (bkz.
# SYSTEM_OVERVIEW.md) bu tur trend-takip mantigi, test edilen donemlerde
# saf grid'den DAHA KOTU sonuc verdi - dikkatli ve kucuk payla deneyin.
# ONEMLI 2: ENTRY/EXIT esikleri %1'in altina indirilmesin - %0.3/-0.3 ile
# test edildiginde 5dk fiyat gurultusune bile tepki verip gunde 5-10 kez
# alim-satim yaparak 180 gunde alt-havuzun %92'sini komisyona yedirdi.
# Asagidaki %1/-%1 varsayilani bu yuzden konuldu.
GRID_TREND_ALLOCATION_PERCENT=0
GRID_TREND_ENTRY_PERCENT=1
GRID_TREND_EXIT_PERCENT=-1

# Trend takibi yerine kanitlanmis alternatif: ayni grid mantiginin (fiyat %X
# dusunce al, o lotun girisinden %X yukselince sat) daha GENIS adimli ikinci
# bir katmani - trend tahmini yok, sadece daha buyuk fiyat sicramalarini da
# yakalamak icin. Seed edilen havuzun bu yuzdesi, kendi ic sayaçlarini tutan
# bagimsiz bir alt-havuzda %5 adimla calisir (ana %1 grid'in parasina hic
# dokunmaz). Sentetik veriyle dogrulandi: %2 gurultuye tepki vermiyor,
# gercek %5+ harekette dogru calisiyor. 0 = kapali (varsayilan). Canliya
# almadan once gercek veriyle backtest edin.
GRID_WIDE_ALLOCATION_PERCENT=0
GRID_WIDE_STEP_DOWN_PERCENT=5
GRID_WIDE_STEP_UP_PERCENT=5
GRID_WIDE_LOT_STOP_PERCENT=10
GRID_WIDE_ORDER_PERCENT=10
GRID_WIDE_MAX_OPEN_LOTS=8

# ONCEKI iki alt-havuzdan (trend takibi, genis grid) FARKLI: bu kez saf fiyat
# yuzdesi degil, trade_bot.py'deki GERCEK RSI + EMA trend mantigi kullanilir.
# Saatlik mumlara resample edilmis kapanislar uzerinden RSI(GRID_RSI_PERIOD)
# ve EMA(kisa saat)/EMA(uzun saat) hesaplanir: kisa EMA > uzun EMA ise
# "yukselis trendi" kabul edilir. O trend suruyorken RSI, ALIM esiginin
# ALTINA duserse (trend icinde geri cekilme/dip) AL; trend kirilirsa (kisa
# EMA < uzun EMA) VEYA RSI, SATIS esiginin USTUNE cikarsa (asiri alim/ralli)
# SAT. Amac: nakitte bos duran payi, gunluk/saatlik trend + RSI kombinasyonu
# ile degerlendirip trend takibi/genis grid'in kacirdigi hareketleri
# yakalamak. Seed edilen havuzun bu yuzdesi kendi ic sayaçlarini tutan
# bagimsiz bir alt-havuzda calisir (grid'in parasina hic dokunmaz). 0 = kapali
# (varsayilan). ONEMLI: bu HENUZ gercek veriyle backtest edilmedi - canliya
# almadan once mutlaka 30/90/180 gunluk backtest yapin (bkz. SYSTEM_OVERVIEW.md
# - buraya kadarki tum trend-takip denemeleri saf grid'den daha kotu cikti,
# bu farkli bir mantik oldugu icin sonucu ayrica test etmek gerekiyor).
GRID_RSI_TREND_ALLOCATION_PERCENT=0
GRID_RSI_PERIOD=14
GRID_RSI_BUY_THRESHOLD=40
GRID_RSI_SELL_THRESHOLD=65
GRID_RSI_EMA_SHORT_HOURS=12
GRID_RSI_EMA_LONG_HOURS=48

# --- adaptive_bot.py / adaptive_backtest.py: hibrit (rejim-uyarlamali) bot.
# DENEYSEL - gercek veriyle test edildiginde saf-grid'den DAHA TUTARSIZ
# cikti (bkz. SYSTEM_OVERVIEW.md), varsayilan/onerilen yol degil, ama
# karsilastirma araci olarak repoda duruyor.
# Kaufman Verimlilik Orani (son REGIME_LOOKBACK mumda net hareket/toplam
# zigzag orani) ile piyasa "TREND" mi "RANGE" mi diye karar verir, ona gore
# trade_bot.py (TREND) veya grid_bot.py (RANGE) mantigiyla giris yapar.
# Acik pozisyonlar hangi mantikla acildiysa o mantikla kapanir.
REGIME_LOOKBACK=20
REGIME_TREND_THRESHOLD=0.3
