# Bu dosyayı .env olarak kopyala ve gerçek değerlerini doldur.
# .env dosyasını ASLA git'e commit etme (zaten .gitignore'da).

# --- Binance API (canlı/testnet mod için) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Güvenlik kilitleri ---
# true = hiç gerçek emir gönderilmez, sanal bakiyeyle test edilir (güvenli varsayılan)
DRY_RUN=true
# true = Binance testnet (sahte para), false = mainnet (gerçek para)
USE_TESTNET=true
# Mainnet'te DRY_RUN=false ile çalışmak için tam olarak bu ibare gerekir:
ONAY_GERCEK_PARA=

# --- İşlem parametreleri ---
WATCHLIST=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,AVAXUSDT,DOTUSDT,LINKUSDT,LTCUSDT
TRADE_AMOUNT_USDT=10
MAX_POSITIONS=3
TRADE_SERMAYE_ORANI=0.5
STOP_LOSS_YUZDE=5
TAKE_PROFIT_YUZDE=8
MAX_GUNLUK_ZARAR_YUZDE=5
TARAMA_ARALIGI_SANIYE=900

# --- Panel (main.py) şifre koruması ---
# Sunucuda herkese açık bir IP/portta yayınlarsan bunu mutlaka ayarla.
APP_SIFRE=
